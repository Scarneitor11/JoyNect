<Project>

  <!--
    JoyNect solution-wide build policy.
    Warnings are errors on purpose: this program drives a virtual gamepad driver, so an ignored
    warning today is a stuck-input bug tomorrow.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Default</AnalysisMode>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Authors>JoyNect contributors</Authors>
    <Product>JoyNect</Product>
    <Company>JoyNect</Company>
    <Copyright>Copyright (c) 2026 JoyNect contributors</Copyright>
    <RepositoryType>git</RepositoryType>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!--
    CS1591: missing XML comment - we only document what is non-obvious.
    CA1416: platform compatibility - every project here is Windows-only by design.
    NU1701: package built for another framework - Nefarius.ViGEm.Client ships netstandard2.0.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1591;CA1416;NU1701</NoWarn>
  </PropertyGroup>

</Project>
