# Copy to .env and fill in locally; .env is ignored by git, this file is not.
#
# Archil account API key. tools/archil_store.py uses it to keep the generated artifacts (screen
# captures, icon sizes) on a disk that outlives a single run. It starts with "key-": that is the
# account credential from the Archil dashboard, not the per-disk mount token.
ARCHIL_API_KEY=

# Optional: pin an existing disk instead of looking up `joynect-artifacts` by name.
# ARCHIL_DISK_ID=

# Optional: Archil region identifier, e.g. aws-us-east-1 (default: the account's region).
# ARCHIL_REGION=
