<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-targeted because virtual pad creation (ViGEm) and HID enumeration are Windows APIs.
         Headless: no WPF, no windowing, so every part of this library is unit-testable. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>JoyNect.Core</RootNamespace>
    <AssemblyName>JoyNect.Core</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" />
    <PackageReference Include="Nefarius.ViGEm.Client" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
