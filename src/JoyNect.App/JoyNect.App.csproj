<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>JoyNect.App</RootNamespace>
    <AssemblyName>JoyNect</AssemblyName>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- The window and every control are built in code, so there is no App.xaml to compile. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JoyNect.Core\JoyNect.Core.csproj" />
    <ProjectReference Include="..\JoyNect.Ui\JoyNect.Ui.csproj" />
  </ItemGroup>

  <!-- The window and tray icons are WPF resources: the pack URI in the window and the tray needs
       them embedded, not just used as the executable's icon.

       The app icon and the tray icon source are optional in the repository: the published build can
       run without app.png if the app icon is embedded in app.ico. The tray control falls back to
       the icon file if the image is absent, so a stripped checkout still builds. -->
  <ItemGroup>
    <Resource Include="assets\app.png" Condition="Exists('assets\app.png')" />
    <Resource Include="assets\app.ico" />
    <Resource Include="assets\icons.gen.xaml" Condition="Exists('assets\icons.gen.xaml')" />
  </ItemGroup>

</Project>
